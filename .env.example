# ==============================================================================
# Multimodal Health Screening Platform - Environment Configuration Example
# Copy this file to .env or set these environment variables in your cloud platform.
# ==============================================================================

# Server Binding
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Database Connection (SQLite local file or PostgreSQL production URL)
# Example PostgreSQL: postgresql://dbuser:securepassword@dbhost:5432/screening_db
DATABASE_URL=sqlite:///./backend/health_screening.db

# CORS Allowed Origins (Comma-separated list of origins permitted to call the API)
# In production, specify your exact frontend domain(s), e.g.:
# CORS_ORIGINS=https://screening.yourhospital.org,https://my-health-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Model Artifact Location (Defaults to ml/weights/eye_model.pth)
CHECKPOINT_PATH=ml/weights/eye_model.pth

# Hardware Execution Target ('auto', 'cpu', 'cuda', 'cuda:0')
# Set to 'cpu' for standard cloud containers without GPU
ML_DEVICE=auto

# Security & Upload Guardrails
MAX_UPLOAD_SIZE_MB=30
