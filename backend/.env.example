# Multimodal Health Screening - Backend Environment Configuration Example
# Copy this file to .env in backend directory or root directory.

# Database URL (SQLite default or PostgreSQL connection string)
# DATABASE_URL=sqlite:///./health_screening.db

# CORS Allowed Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Server Binding
HOST=127.0.0.1
PORT=8000

# ML Model Checkpoint Path (defaults to ml/weights/eye_model.pth)
# CHECKPOINT_PATH=../ml/weights/eye_model.pth

# Maximum Upload File Size in Megabytes
MAX_UPLOAD_SIZE_MB=30
