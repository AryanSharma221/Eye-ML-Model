# Backend API base URL
# Local Development: http://localhost:8000
# Production Detached (e.g. Vercel / Netlify): https://api.yourdomain.com
# Production Co-located / Reverse-Proxied: leave empty (defaults to same-origin /api/v1)
VITE_BACKEND_URL=http://localhost:8000
