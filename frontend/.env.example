# ==============================================================================
# Multimodal Health Screening Frontend - Environment Configuration Example
# Copy this file to .env, .env.development, or .env.production as needed.
# ==============================================================================

# Backend API Base URL Configuration:
# - Option A: Full API Base URL (including /api/v1)
#   VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
#
# - Option B: Backend Host Origin (auto-appends /api/v1)
#   VITE_BACKEND_URL=https://api.yourdomain.com
#
# - Option C: Production Same-Origin / Reverse Proxy (e.g. Docker / Nginx)
#   Leave both empty to automatically use relative path (/api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_BACKEND_URL=http://localhost:8000
